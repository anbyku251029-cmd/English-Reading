# ==============================================================================
# Booky - 영어 원서 읽기 & 회화 AI 코치 환경 변수 안내 (.env.example)
# ==============================================================================
# 로컬 개발 시 이 파일을 복사하여 .env.local 파일을 생성한 후 실제 키를 입력하세요.
# 주의: .env.local 파일은 .gitignore에 등록되어 있으므로 Git에 절대 커밋되지 않습니다.
#
# Google AI Studio에서 무료로 API 키를 발급받을 수 있습니다:
# https://aistudio.google.com/app/apikey
# ==============================================================================

# [필수] Google Gemini API Key
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# [선택] 텍스트 생성 모델 (기본값: gemini-2.5-flash)
# 지원 모델 예시: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL="gemini-2.5-flash"

# [선택] TTS 음성 생성 모델 (기본값: gemini-3.8-flash-lite-tts)
GEMINI_TTS_MODEL="gemini-3.8-flash-lite-tts"

# [선택] 로컬 서버 포트 (기본값: 3000)
PORT="3000"
